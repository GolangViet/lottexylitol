#AuthUserFile /home/lottexylitolcom/public_html/.htpasswd
#AuthType Basic
#AuthName "Web access"
#Require valid-user
#Satisfy all

RewriteCond %{HTTPS} !on
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

RewriteEngine On

RewriteBase /
RewriteCond %{HTTP_HOST} ^www.lottexylitol.com.vn [NC]
RewriteRule ^(.*)$ https://lottexylitol.com.vn/$1 [L,R=301]

RedirectMatch 301 ^/vn/trang-chu.html /
RedirectMatch 301 ^/vn/tim-hieu-ve-xylitol.html /what-is-xylitol/
RedirectMatch 301 ^/vn/san-pham.html /what-is-xylitol/
RedirectMatch 301 ^/vn/xylitol-cool.html /product/
RedirectMatch 301 ^/vn/xylitol.html /product/
RedirectMatch 301 ^/vn/quang-cao.html /movie/
RedirectMatch 301 ^/vn/kien-thuc.html /why-xylitol/

RedirectMatch 301 ^/en/home.html /en/
RedirectMatch 301 ^/en/what-is-xylitol.html /en/what-is-xylitol/
RedirectMatch 301 ^/en/product.html /en/product/
RedirectMatch 301 ^/en/xylitol-cool.html /en/product/
RedirectMatch 301 ^/en/xylitol.html /en/product/
RedirectMatch 301 ^/en/advertising.html /en/movie/
RedirectMatch 301 ^/en/education.html /en/why-xylitol/

# Redirect old campaign
RedirectMatch 301 ^/thuthachvotucuoi/ /
RedirectMatch 301 ^/en/thuthachvotucuoi/ /en/
RedirectMatch 301 ^/phienbanchibi/ /

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

