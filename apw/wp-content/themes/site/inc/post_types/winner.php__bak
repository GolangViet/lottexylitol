<?php
/*
* Creating a function to create our CPT
*/
function site_winner_init()
{
    register_taxonomy('winner_cat', 'winner', array(
        'labels' => array(
            'name'                       => _x('Winner Categories', 'site'),
            'singular_name'              => _x('Winner Category', 'site'),
            'search_items'               => __('Search Category', 'site'),
            'popular_items'              => __('Popular Category', 'site'),
            'all_items'                  => __('All Categories', 'site'),
            'parent_item'                => null,
            'parent_item_colon'          => null,
            'edit_item'                  => __('Edit Category', 'site'),
            'update_item'                => __('Update Category', 'site'),
            'add_new_item'               => __('Add New Category', 'site'),
            'new_item_name'              => __('New Category Name', 'site'),
            'separate_items_with_commas' => __('Separate Category with commas', 'site'),
            'add_or_remove_items'        => __('Add or remove Category', 'site'),
            'choose_from_most_used'      => __('Choose from the most used Category', 'site'),
            'not_found'                  => __('No Category found.', 'site'),
            'menu_name'                  => __('Categories', 'site'),
        ),
        'show_ui'               => true,
        'show_admin_column'     => true,
        'update_count_callback' => '_update_post_term_count',
        'query_var'             => true,
        'hierarchical'          => true,
        'has_archive'           => false,
        'public'                => false,
    ));
    
    register_post_type('winner', array(
        'labels' => array(
            'name'                => _x('Winners', 'Post Type General Name', 'site'),
            'singular_name'       => _x('Winner', 'Post Type Singular Name', 'site'),
            'menu_name'           => __('Winners', 'site'),
            'all_items'           => __('All Winners', 'site'),
            'view_item'           => __('View Winner', 'site'),
            'add_new_item'        => __('Add New Winner', 'site'),
            'add_new'             => __('Add New', 'site'),
            'edit_item'           => __('Edit Winner', 'site'),
            'update_item'         => __('Update Winner', 'site'),
            'search_items'        => __('Search Winner', 'site'),
            'not_found'           => __('Not Found', 'site'),
            'not_found_in_trash'  => __('Not found in Trash', 'site'),
        ),
        'public'             => false,
        'publicly_queryable' => false,
        'show_ui'            => true,
        'show_in_menu'       => true,
        'query_var'          => true,
        'rewrite'            => true,
        'capability_type'    => 'post',
        'has_archive'        => false,
        'hierarchical'       => false,
        // 'show_in_rest'       => true,
        'menu_position'      => 30,
        'menu_icon'          => 'dashicons-list-view',
        'supports'           => array('title')
    ));
}
// add_action('init', 'site_winner_init');

function site_winner_get_data_by($page_id)
{
    $list = [];

    $p = get_post($page_id);

    if($p && $p->post_content) {
        $pages = site_get_pages_by_post($p);

        foreach($pages as $content) {
            $list[] = [
                'title' => site_get_html_by_tag($content, 'h3'),
                'content' => site_get_html_by_tag($content, 'table'),
            ];
        }
    }

    return $list;
}

function site_winner_get_terms()
{
    $items = get_terms([
        'taxonomy' => 'winner_cat',
        'hide_empty' => false
    ]);

    $list = array();

    if ($items) {
        foreach ($items as $item) {
            $list[] = array(
                'name'  => $item->name,
                'slug'  => $item->slug,
            );
        }
    }

    return $list;
}

function site_winner_get_posts($tax_slug = '')
{
    $args = array(
        'post_type' => 'winner'
    );

    if ($tax_slug != '') {
        $args['tax_query'] = array(
            array(
                'taxonomy' => 'winner_cat',
                'field' => 'slug',
                'terms' => [$tax_slug],
            ),
        );
    }

    // The Query.
    $the_query = new WP_Query($args);

    $list = array();

    if ($the_query->have_posts()) {
        foreach ($the_query->posts as $p) {
            $list[] = array(
                'name'  => $p->post_title,
                'phone' => $p->post_excerpt,
                'city'  => $p->post_content,
            );
        }
    }

    return $list;
}

function site_winner_enter_title_here($text = '', $post = null)
{
    if($post->post_type == 'winner') {
        $text = __('Full name', 'site');
    }

    return $text;
}
add_filter('enter_title_here', 'site_winner_enter_title_here', 10, 2);

function site_winner_restrict_manage_posts($post_type = '', $which = '')
{
    if($post_type == 'winner' && $which == 'top') {
        $tax = 'winner_cat';

        $selected = isset($_GET[$tax]) ? intval($_GET[$tax]) : 0;

        $dropdown_options = array(
            'show_option_all' => get_taxonomy($tax)->labels->all_items,
            'hide_empty'      => 0,
            'hierarchical'    => 1,
            'show_count'      => 0,
            'name'            => $tax,
            'orderby'         => 'name',
            'selected'        => $selected,
        );

        echo '<label class="screen-reader-text" for="cat">' . get_taxonomy($tax)->labels->filter_by_item . '</label>';

        wp_dropdown_categories( $dropdown_options );
    }
}
// add_action('restrict_manage_posts', 'site_winner_restrict_manage_posts', 10, 2);

function site_winner_add_meta_box($post_type)
{
    if ($post_type == 'winner') {
        add_meta_box(
            'winner_meta_box',
            __('Information', 'site'),
            'site_winner_render_meta_box_content',
            $post_type,
            'advanced',
            'high'
        );
    }
}
add_action('add_meta_boxes', 'site_winner_add_meta_box');

function site_winner_render_meta_box_content($post = null)
{
    ?>
        <table class="form-table" role="presentation">
            <tr class="row">
                <th scope="row"><label><?php _e('Phone', 'site') ?></label></th>
                <td>
                    <input value="<?php esc_attr_e($post->post_excerpt) ?>" name="post_excerpt" type="text" class="large-text" />
                </td>
            </tr>
            <tr class="row">
                <th scope="row"><label><?php _e('City', 'site') ?></label></th>
                <td>
                    <textarea name="post_content" class="large-text"><?php esc_html_e($post->post_content) ?></textarea>
                </td>
            </tr>
        </table>
    <?php
}

function site_winner_custom_add_post_column($columns = array(), $post_type = '')
{
    if ($post_type == 'winner') {
        $list = array();

        foreach ($columns as $key => $column) {
            if ($key == 'title') {
                $list[$key] = __('Full name', 'site');
                $list['post_excerpt'] = __('Phone', 'site');
                $list['post_content'] = __('City', 'site');
            } else {
                $list[$key] = $column;
            }
        }

        $columns = $list;
    }

    return $columns;
}

function site_winner_custom_post_column($column = '', $post_id = null)
{
    if (get_post_type($post_id) == 'winner') {
        $p = get_post($post_id);
        if(isset($p->$column)) {
            esc_attr_e($p->$column);
        }
    }
}

function site_winner_admin_init()
{
    add_filter('manage_posts_columns', 'site_winner_custom_add_post_column', 10, 2);
    add_action('manage_posts_custom_column', 'site_winner_custom_post_column', 10, 2);
}
add_action('admin_init', 'site_winner_admin_init');
