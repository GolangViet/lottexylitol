add_action( 'admin_init', 'site_admin_options_reading', 10, 2 );

function site_admin_setting_get_values($option_name = '')
{
	$values = [];

	if(get_option($option_name, 0) > 0) {
		$values[] = get_option($option_name, 0);
	}
	
	if(get_option($option_name . '_en', 0) > 0) {
		$values[] = get_option($option_name . '_en', 0);
	}

	return $values;
}

function site_admin_register_setting_winner()
{
	/**
	 * field: winner_id
	 */
	register_setting(
		'reading',
		'winner_id'
	);

	add_settings_field(
		'winner_id',
		__( 'Winner Page', 'site' ),
		function(){
            $id = get_option('winner_id');

            $list = get_pages();

			$output = '<select type="number" id="winner_id" name="winner_id">' . "\n";
            $output .= '<option value="">-- ' . __('Select Page', 'site') . " --</option>\n";            
            foreach($list as $p) {
                $output .= '<option value="'.$p->ID.'" '.selected( $id, $p->ID, false ).'>' . $p->post_title . "</option>\n";
            }            
            echo $output . '</select>' . "\n";
		},
		'reading',
		'default',
		array( 'label_for' => 'winner_id' )
	);
	// End `winner_id`

	/**
	 * field: winner_id_en
	 */
	register_setting(
		'reading',
		'winner_id_en'
	);

	add_settings_field(
		'winner_id_en',
		__( 'Winner Page (EN)', 'site' ),
		function(){
            $id = get_option('winner_id_en');

            $list = get_pages();

			$output = '<select type="number" id="winner_id_en" name="winner_id_en">' . "\n";
            $output .= '<option value="">-- ' . __('Select Page', 'site') . " --</option>\n";            
            foreach($list as $p) {
                $output .= '<option value="'.$p->ID.'" '.selected( $id, $p->ID, false ).'>' . $p->post_title . "</option>\n";
            }            
            echo $output . '</select>' . "\n";
		},
		'reading',
		'default',
		array( 'label_for' => 'winner_id_en' )
	);
	// End `winner_id_en`
}