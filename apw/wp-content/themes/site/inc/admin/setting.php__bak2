<?php
defined('ABSPATH') or die();

function site_admin_enqueue_scripts()
{
	$url = get_template_directory_uri(). '/assets/';

	wp_enqueue_style( 'admin', 	$url. 'css/admin.css' );
	wp_enqueue_script( 'admin', $url. 'js/admin.js', array('jquery', 'jquery-ui-sortable'), '', true );
}
add_action( 'admin_enqueue_scripts', 'site_admin_enqueue_scripts' );

/**
 * Menu: Settings -> Reading
 * 
 * wp-admin/options-reading.php
 */
function site_admin_options_reading()
{
	/**
	 * Heading: site
	 */
	add_settings_field(
		'heading_custom',
		'<h2 id="site-settings">' . __( 'Site Settings', 'site' ) . ':</h2>',
		function(){ echo ''; },
		'reading',
		'default',
		array()
	);
	
	/**
	 * field: survey_id
	 */
	register_setting(
		'reading',
		'survey_id'
	);

	add_settings_field(
		'survey_id',
		__( 'Survey User', 'site' ),
		function(){
            $id = get_option('survey_id');

            $list = get_posts([
                'post_type' => 'survey'
            ]);

			$output = '<select type="number" id="survey_id" name="survey_id">' . "\n";
            $output .= '<option value="">-- ' . __('Select Survey', 'site') . " --</option>\n";            
            foreach($list as $p) {
                $output .= '<option value="'.$p->ID.'" '.selected( $id, $p->ID, false ).'>' . $p->post_title . "</option>\n";
            }            
            echo $output . '</select>' . "\n";
		},
		'reading',
