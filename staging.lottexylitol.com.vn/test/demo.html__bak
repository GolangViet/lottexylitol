<!DOCTYPE html>
<html lang="en">

<head>
    <meta name="robots" content="noindex">
    <meta charset="utf-8">
    <meta name="color-scheme" content="light dark">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Draggable</title>
    <link rel="stylesheet" href="/assets/css/style.css">
    <link href="/assets/css/custom.css" rel="stylesheet">
    <link href="/assets/css/new-styles.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/jquery-ui.css">
</head>

<body id="about-photo-contest" class="about-photo-contest product vn about-must-buy p-must-buy">
    <div id="wrap">
        <!-- Main Content
        ================================================== -->
        <main class="main bgmain">
            <div class="breadcrumb">
                <ul>
                    <li><a href="/">Trang chủ</a></li>
                    <li><a href="/membership-activities/">Hoạt động thành viên</a></li>
                    <li>Nhận quà liền tay</li>
                </ul>
            </div>
            <div class="section">
                <div class="section-contest section-must-buy fill-blank active" id="fill-blank">
                    <div class="txt-center">
                        <p class="title u-pb-20 u-sp-pb-10">Điền vào chỗ trống</p>
                        <p class="u-pb-20 u-sp-pb-10">Kéo câu trả lời vào chỗ trống để hoàn thiện câu</p>
                    </div>
                    <div class="group-questions">
                        <div class="txt-center u-pb-30 u-sp-pb-30">
                        </div>
                    </div>
                    <div class="group-answers">
                        <div class="row-answer u-pb-50 u-sp-pb-40">
                            <a class="btn-dark-green-2 shadow-2 js-answer-item" data-value="disabled">
                                <i class="before"><img src="/assets/img/must-buy/icon-06.png" alt=""></i>
                                <span data-value="8406f0072f7f924b505334dfcfae189b">Vi Khuẩn</span>
                            </a>
                        </div>
                        <div class="row-answer u-pb-50 u-sp-pb-40">
                            <a class="btn-dark-green-2 shadow-2 js-answer-item" data-value="selected">
                                <i class="before"><img src="/assets/img/must-buy/icon-04.png" alt=""></i>
                                <span data-value="c8d6ebb76bf3c72baa67a711197d9d00">Ngăn Ngừa Sâu Răng</span>
                            </a>
                        </div>
                        <div class="row-answer u-pb-50 u-sp-pb-40">
                            <a class="btn-dark-green-2 shadow-2 js-answer-item" data-value="selected">
                                <i class="before"><img src="/assets/img/must-buy/icon-05.png" alt=""></i>
                                <span data-value="e2dc359e69b0f2b8a88a60571fa82c1c">Mutan Gây Sâu Răng</span>
                            </a>
                        </div>
                        <div class="row-answer u-pb-50 u-sp-pb-40">
                            <a class="btn-dark-green-2 shadow-2 js-answer-item" data-value="disabled">
                                <i class="before"><img src="/assets/img/must-buy/icon-07.png" alt=""></i>
                                <span data-value="a48d9c02b804383ffa0dae32dde2e19a">Sâu răng</span>
                            </a>
                        </div>
                        <div class="row-answer u-pb-50 u-sp-pb-40">
                            <a class="btn-dark-green-2 shadow-2 js-answer-item" data-value="disabled">
                                <span data-value="cfb8c1089c9184e76fe07019a4b74c3a">Virus</span>
                            </a>
                        </div>
                        <div class="row-answer u-pb-50 u-sp-pb-40">
                            <a class="btn btn-primary js-answer-item" data-value="disabled">
                                <span data-value="cfb8c1089c9184e76fe07019a4b74c3a">Virus</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="/assets/js/lib/jquery1-12-4.min.js"></script>
    <script src="/assets/js/lib/jquery-ui-1.14.1.min.js"></script>
    <script src="/assets/js/lib/jquery.ui.touch-punch.min.js"></script>

    <!-- <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui-touch-punch/0.2.3/jquery.ui.touch-punch.min.js" integrity="sha512-0bEtK0USNd96MnO4XhH8jhv3nyRF0eK87pJke6pkYf3cM0uDIhNJy9ltuzqgypoIFXw3JSuiy04tVk4AjpZdZw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script> -->
    
    <script>
        $(".js-answer-item").draggable({
            containment: "body",
            revert: true
        });
    </script>
</body>

</html>
