    <script>
        // add the listener for receiving a message from the popup
        window.addEventListener('message', (event) => {

            // Do we trust the sender of this message? (might be different from what we originally opened, for example).
            if (event.origin !== location.origin) {
                return;
            }

            const { data } = event;

            // console.log(data.popup); //<--- THIS WHERE I'm SEEING DUPLICATES

            if(data.popup) {
                setTimeout(function(){
                    console.log('Popup end game!');

                    $.fancybox({padding: 0,content: $('#box-thanks')});
                }, 1000);
            }

        }, false);
    </script>
