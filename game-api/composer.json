{
  "name": "x-team/minigame",
  "description": "The HTML5 Game",
  "keywords": [
    "microframework",
    "rest",
    "router",
    "psr7"
  ],
  "homepage": "http://github.com/quangtran/x-minigame",
  "license": "MIT",
  "authors": [
    {
      "name": "phpslim",
      "email": "info@joshlockhart.com",
      "homepage": "http://www.joshlockhart.com/"
    }
  ], 
  "require": {
    "php": "^7.4 || ^8.0",
    "ext-json": "*",
    "firebase/php-jwt": "^6.10",
    "guzzlehttp/guzzle": "^7.0",
    "illuminate/database": "~10.1",
    "monolog/monolog": "^2.8",
    "php-di/php-di": "^6.4",
    "slim/psr7": "^1.5",
    "slim/slim": "^4.10",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "jangregor/phpstan-prophecy": "^1.0.0",
    "phpspec/prophecy-phpunit": "^2.0",
    "phpstan/extension-installer": "^1.2.0",
    "phpstan/phpstan": "^1.8",
    "phpunit/phpunit": "^9.5.26",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "kylekatarnls/update-helper": false
    },
    "process-timeout": 0,
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "start": "php -S localhost:8080 -t public",
    "test": "phpunit"
  }
}
